{
  "openapi": "3.1.0",
  "info": {
    "title": "Gemini 原生批量嵌入格式",
    "version": "1.0.0",
    "description": "使用 requests 数组提交多条嵌入请求，返回 embeddings[].values。每条请求使用 Gemini content.parts 结构。也支持 `/v1/models/{model}:batchEmbedContents` 兼容路径。"
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "GeminiApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-goog-api-key"
      },
      "GeminiQueryKey": {
        "type": "apiKey",
        "in": "query",
        "name": "key"
      },
      "AnthropicApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    }
  },
  "paths": {
    "/v1beta/models/{model}:batchEmbedContents": {
      "post": {
        "operationId": "batchembedcontents",
        "tags": [
          "嵌入（Embeddings）"
        ],
        "summary": "Gemini 原生批量嵌入格式",
        "description": "使用 requests 数组提交多条嵌入请求，返回 embeddings[].values。每条请求使用 Gemini content.parts 结构。也支持 `/v1/models/{model}:batchEmbedContents` 兼容路径。",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "GeminiApiKey": []
          },
          {
            "GeminiQueryKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "embeddings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "values": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "required": true,
            "description": "平台可用的模型 ID，不带 models/ 前缀",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requests": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "model": {
                          "type": "string",
                          "description": "可选，格式为 models/{model}；网关按路径及模型映射设置。"
                        },
                        "content": {
                          "type": "object",
                          "properties": {
                            "role": {
                              "type": "string"
                            },
                            "parts": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": true,
                                "properties": {
                                  "text": {
                                    "type": "string"
                                  }
                                },
                                "description": "文本使用 text；媒体输入、工具调用等按 Gemini 内容块格式填写。"
                              }
                            }
                          },
                          "required": [
                            "parts"
                          ]
                        },
                        "taskType": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "outputDimensionality": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "content"
                      ]
                    }
                  }
                },
                "required": [
                  "requests"
                ]
              }
            }
          }
        }
      }
    }
  }
}
