{
  "openapi": "3.1.0",
  "info": {
    "title": "Responses 压缩格式",
    "version": "1.0.0",
    "description": "压缩 Responses 对话上下文，返回 object=response.compaction 和 output。非流式接口；需要支持压缩能力的上游渠道，不属于 Responses 转 Chat Completions 的兼容回退。"
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "GeminiApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-goog-api-key"
      },
      "GeminiQueryKey": {
        "type": "apiKey",
        "in": "query",
        "name": "key"
      },
      "AnthropicApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    }
  },
  "paths": {
    "/v1/responses/compact": {
      "post": {
        "operationId": "compactresponse",
        "tags": [
          "聊天（Chat）/原生OpenAI格式"
        ],
        "summary": "Responses 压缩格式",
        "description": "压缩 Responses 对话上下文，返回 object=response.compaction 和 output。非流式接口；需要支持压缩能力的上游渠道，不属于 Responses 转 Chat Completions 的兼容回退。",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "object": {
                      "type": "string",
                      "example": "response.compaction"
                    },
                    "created_at": {
                      "type": "integer"
                    },
                    "output": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "usage": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "error": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "input": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": true
                        }
                      }
                    ]
                  },
                  "instructions": {
                    "type": "string"
                  },
                  "previous_response_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "model"
                ]
              }
            }
          }
        }
      }
    }
  }
}
