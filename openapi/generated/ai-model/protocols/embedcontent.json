{
  "openapi": "3.1.0",
  "info": {
    "title": "Gemini 原生单条嵌入格式",
    "version": "1.0.0",
    "description": "使用 content.parts 输入文本，返回 embedding.values。不同于 /v1/embeddings 的 input/data[].embedding。也支持 `/v1/models/{model}:embedContent` 兼容路径；维度及任务类型取决于模型。"
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "GeminiApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-goog-api-key"
      },
      "GeminiQueryKey": {
        "type": "apiKey",
        "in": "query",
        "name": "key"
      },
      "AnthropicApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    }
  },
  "paths": {
    "/v1beta/models/{model}:embedContent": {
      "post": {
        "operationId": "embedcontent",
        "tags": [
          "嵌入（Embeddings）"
        ],
        "summary": "Gemini 原生单条嵌入格式",
        "description": "使用 content.parts 输入文本，返回 embedding.values。不同于 /v1/embeddings 的 input/data[].embedding。也支持 `/v1/models/{model}:embedContent` 兼容路径；维度及任务类型取决于模型。",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "GeminiApiKey": []
          },
          {
            "GeminiQueryKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "embedding": {
                      "type": "object",
                      "properties": {
                        "values": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "required": true,
            "description": "平台可用的模型 ID，不带 models/ 前缀",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "可选，格式为 models/{model}；网关按路径及模型映射设置。"
                  },
                  "content": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "type": "string"
                      },
                      "parts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": true,
                          "properties": {
                            "text": {
                              "type": "string"
                            }
                          },
                          "description": "文本使用 text；媒体输入、工具调用等按 Gemini 内容块格式填写。"
                        }
                      }
                    },
                    "required": [
                      "parts"
                    ]
                  },
                  "taskType": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "outputDimensionality": {
                    "type": "integer"
                  }
                },
                "required": [
                  "content"
                ]
              }
            }
          }
        }
      }
    }
  }
}
