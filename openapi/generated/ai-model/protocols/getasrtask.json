{
  "openapi": "3.1.0",
  "info": {
    "title": "查询异步语音转录",
    "version": "1.0.0",
    "description": "使用提交响应的 task_id 查询。pending/running 表示尚未完成，succeeded 时读取 text/duration/transcripts，failed 时读取 error。任务访问受账号及令牌模型权限限制。"
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "GeminiApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-goog-api-key"
      },
      "GeminiQueryKey": {
        "type": "apiKey",
        "in": "query",
        "name": "key"
      },
      "AnthropicApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    }
  },
  "paths": {
    "/v1/audio/transcriptions/async/{task_id}": {
      "get": {
        "operationId": "getasrtask",
        "tags": [
          "音频（Audio）"
        ],
        "summary": "查询异步语音转录",
        "description": "使用提交响应的 task_id 查询。pending/running 表示尚未完成，succeeded 时读取 text/duration/transcripts，failed 时读取 error。任务访问受账号及令牌模型权限限制。",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "task_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "running",
                        "succeeded",
                        "failed"
                      ]
                    },
                    "model": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "integer"
                    },
                    "text": {
                      "type": "string"
                    },
                    "duration": {
                      "type": "number",
                      "description": "音频时长，单位为秒。"
                    },
                    "transcripts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "sentences": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "begin_time": {
                                  "type": "integer"
                                },
                                "end_time": {
                                  "type": "integer"
                                },
                                "text": {
                                  "type": "string"
                                },
                                "speaker_id": {
                                  "type": "integer"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "error": {
                      "type": "string"
                    },
                    "finished_at": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "description": "提交接口返回的任务 ID",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
